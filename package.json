  "repository": {
    "type": "git",
    "url": "https://github.com/TryHackX/SoldatMapTool.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "description": "Soldat Map Studio - Zaawansowane pakowanie map (MPA Pro), przeglądarka po prefixach, klasyczny podgląd WebGL2 oraz generator Full-Size Screen (100% View)",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "test:pms": "tsx src/server/testAllMaps.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "readdir-glob": {
      "minimatch": "^11.0.3"
    }
  }
}
